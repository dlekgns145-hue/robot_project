# Prefer a stable /dev/serial/by-id path. install.sh detects the single CP210x
# controller automatically when this value is omitted.
ROBOT_SERIAL_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
ROBOT_SERIAL_BAUD=921600

# Autonomous mapping safety envelope. The defaults cover the current roughly
# 10 m field while preventing an unbounded exploration run.
ROBOT_MAPPING_MAXIMUM_RUNTIME=900.0
ROBOT_MAPPING_MAXIMUM_RADIUS=8.0
ROBOT_MAPPING_GOAL_PROGRESS_TIMEOUT=55.0
ROBOT_MAPPING_MAXIMUM_MAP_AGE=8.0
ROBOT_MAPPING_MINIMUM_SAVE_KNOWN_AREA=1.0
ROBOT_MAPPING_MINIMUM_SAVE_FREE_AREA=0.5

# Commands produced by local or server Nav2 are proposals on
# /cmd_vel_server. robot_cmd_bridge is the only final /cmd_vel publisher and
# expires the lease if the compute server or Wi-Fi stops responding.
SERVER_COMMAND_TIMEOUT_SEC=0.5
SERVER_MAX_LINEAR_SPEED=0.12
SERVER_MAX_ANGULAR_SPEED=0.18
ZENOH_BRIDGE_IMAGE=eclipse/zenoh-bridge-ros2dds:latest
