# Default architecture: GUI -> Ubuntu VM gateway -> Raspberry Pi robot bridge.
ROBOT_GATEWAY_IMAGE=robot-control-v2-gateway:bookworm

# Stable robot identity. Set the Wi-Fi adapter MAC, not Ethernet MAC.
# Example: ROBOT_MAC=dc:a6:32:12:34:56
ROBOT_MAC=

# mDNS fallback. Keep this because the robot already advertises this name.
ROBOT_HOST=raspberrypi.local

# Emergency override only. Normally leave empty so DHCP changes are followed.
ROBOT_IP=
ROBOT_PORT=9999
ROBOT_ID=robot-1
ROBOT_NAME=Yahboom Robot 1

# Leave blank to auto-detect the VM's default network interface/local subnet.
ROBOT_INTERFACE=
ROBOT_DISCOVERY_CIDR=
ROBOT_DISCOVERY_CACHE_SEC=30
ROBOT_DISCOVERY_TIMEOUT_SEC=8
ROBOT_CONNECT_TIMEOUT_SEC=1.5
ROBOT_RECONNECT_INTERVAL_SEC=10
ROBOT_HEARTBEAT_INTERVAL_SEC=1.0

# GUI always connects to the Ubuntu VM on this TCP port.
COMMAND_PORT=9999
COMMAND_TOKEN=replace-with-a-private-value
CLIENT_IDLE_TIMEOUT_SEC=3.0
MAX_LINEAR_SPEED=0.5
MAX_ANGULAR_SPEED=0.8

# Optional `direct-hardware` profile only. Not used by the default gateway mode.
ROBOT_IMAGE=robot-control-v2:humble
BASE_IMAGE=yahboomtechnology/ros-humble:4.1.2
ROS_DOMAIN_ID=20
# Hybrid compute profile. The Ubuntu server subscribes to robot sensor topics
# and returns only short-lived /cmd_vel_server proposals.
ROBOT_COMPUTE_IMAGE=robot-control-compute:humble
COMPUTE_BASE_IMAGE=ros:humble-ros-base-jammy
ZENOH_BRIDGE_IMAGE=eclipse/zenoh-bridge-ros2dds:latest
ROBOT_CAMERA_URL=http://172.30.1.10:8080/stream.mjpg
ROBOT_MAPPING_MAXIMUM_RUNTIME=900.0
ROBOT_MAPPING_MAXIMUM_RADIUS=8.0
ROBOT_TEXTURE_SOURCE_TOP_FRACTION=0.50
ROBOT_TEXTURE_NEAR_M=0.18
ROBOT_TEXTURE_FAR_M=2.0
ROBOT_TEXTURE_NEAR_WIDTH_M=0.85
ROBOT_TEXTURE_FAR_WIDTH_M=1.8
ROBOT_CAMERA_HORIZONTAL_FOV_DEG=68.0
ROBOT_CAMERA_VERTICAL_FOV_DEG=50.0
ROBOT_CAMERA_YAW_OFFSET_DEG=0.0
ROBOT_CAMERA_PITCH_DOWN_DEG=18.0
ROBOT_CAMERA_HEIGHT_M=0.24
ROBOT_LIDAR_X_OFFSET_M=-0.0046
ROBOT_LIDAR_Y_OFFSET_M=0.0
ROBOT_OBSTACLE_LAYER_RENDER_PERIOD=2.0
ROBOT_SENSOR_SYNC_MAXIMUM_SKEW=0.18
ROBOT_WORKSPACE_SETUP=/root/yahboomcar_ros2_ws/install/setup.bash
BASE_NODE_PACKAGE=yahboomcar_base_node
BASE_NODE_EXECUTABLE=base_node_X3
BASE_NODE_ARGS=
MICROROS_AGENT_ARGS=udp4 --port 9999 -v6
DIRECT_COMMAND_PORT=10099
COMMAND_TIMEOUT_SEC=0.7
LIDAR_REQUIRED=true
LIDAR_TIMEOUT_SEC=1.0
