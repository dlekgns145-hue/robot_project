FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get -o Acquire::ForceIPv4=true update \
    && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends arp-scan iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/robot-control-v2
COPY robot_app/config.py robot_app/robot_locator.py \
    robot_app/operations_store.py robot_app/map_payload.py \
    robot_app/map_inbox.py robot_app/robot_gateway.py ./robot_app/

CMD ["python3", "/opt/robot-control-v2/robot_app/robot_gateway.py"]
