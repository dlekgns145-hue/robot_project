FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends arp-scan iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/robot-control-v2
COPY robot_app/config.py robot_app/robot_locator.py robot_app/robot_gateway.py ./robot_app/

CMD ["python3", "/opt/robot-control-v2/robot_app/robot_gateway.py"]
