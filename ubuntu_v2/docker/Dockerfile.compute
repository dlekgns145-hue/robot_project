ARG BASE_IMAGE=ros:humble-ros-base-jammy
FROM ${BASE_IMAGE}

ARG ROS_APT_MIRROR=https://mirrors.aliyun.com/ros2/ubuntu

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN ros_source_files="$(grep -RIl 'packages\.ros\.org/ros2/ubuntu' \
        /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null || true)" \
    && if [ -n "${ros_source_files}" ]; then \
        sed -i -E \
            "s#https?://packages\.ros\.org/ros2/ubuntu#${ROS_APT_MIRROR}#g" \
            ${ros_source_files}; \
    fi \
    && apt-get -o Acquire::ForceIPv4=true update \
    && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
        python3-opencv \
        python3-numpy \
        ros-humble-navigation2 \
        ros-humble-nav2-bringup \
        ros-humble-slam-toolbox \
        ros-humble-rmw-cyclonedds-cpp \
    && apt-get clean

WORKDIR /opt/robot-control
COPY robot_docker/entrypoint.sh /opt/robot-control/entrypoint.sh
COPY robot_docker/camera_stream_server.py /opt/robot-control/camera_stream_server.py
COPY robot_docker/robot_cmd_bridge.py /opt/robot-control/robot_cmd_bridge.py
COPY robot_docker/navigation_runtime_launch.py \
     robot_docker/mapping_runtime_launch.py \
     robot_docker/navigation_probe.py \
     robot_docker/navigation_run_test.py \
     robot_docker/publish_initial_pose.py \
     robot_docker/prepare_navigation_params.py \
     robot_docker/scan_diagnostics.py \
     robot_docker/odom_relay.py \
     robot_docker/cmd_vel_relay.py \
     robot_docker/scan_time_fix.py \
     robot_docker/autonomous_mapping.py \
     robot_docker/frontier_core.py \
     robot_docker/mapping_core.py \
     robot_docker/map_bundle.py \
     robot_docker/camera_obstacle_guard.py \
     /opt/robot-control/navigation/
COPY robot_docker/recovered/Broom.yaml \
     robot_docker/recovered/Broom.pgm \
     robot_docker/recovered/dwb_nav_params_fixed.yaml \
     robot_docker/mapping_slam_params.yaml \
     /opt/robot-control/navigation/
COPY ubuntu_v2/robot_app/map_postprocess.py \
     /opt/robot-control/navigation/map_postprocess.py

RUN chmod 0755 /opt/robot-control/entrypoint.sh \
    /opt/robot-control/navigation/*.py \
    && mkdir -p /opt/robot-control/maps

# Match the robot image: included Nav2 nodes must use the isolated TF graph
# selected by mapping_runtime_launch.py/navigation_runtime_launch.py.
RUN sed -i "s|'/tf', 'tf'|'/tf', '/tf_nav'|g" \
    /opt/ros/humble/share/nav2_bringup/launch/bringup_launch.py \
    /opt/ros/humble/share/nav2_bringup/launch/localization_launch.py \
    /opt/ros/humble/share/nav2_bringup/launch/navigation_launch.py

ENTRYPOINT ["/opt/robot-control/entrypoint.sh"]
CMD ["mapping-server"]
