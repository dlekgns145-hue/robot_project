# Ready configuration for this physical robot.
# Company Wi-Fi: wlan0, MAC 2c:cf:67:7b:48:d7
# Robot hotspot: wlan1, 10.42.0.1 (not used for company-LAN discovery)
ROBOT_GATEWAY_IMAGE=robot-control-v2-gateway:bookworm

ROBOT_MAC=2c:cf:67:7b:48:d7
ROBOT_HOST=raspberrypi.local
ROBOT_IP=
ROBOT_PORT=9999

# Auto-detect the Ubuntu VM interface and its local subnet.
ROBOT_INTERFACE=
ROBOT_DISCOVERY_CIDR=
ROBOT_DISCOVERY_CACHE_SEC=30
ROBOT_DISCOVERY_TIMEOUT_SEC=8
ROBOT_CONNECT_TIMEOUT_SEC=1.5
ROBOT_RECONNECT_INTERVAL_SEC=10

COMMAND_PORT=9999
COMMAND_TOKEN=rbt2-9f73c1e6b84a42d5a167f2c4e0d98b31
CLIENT_IDLE_TIMEOUT_SEC=3.0
MAX_LINEAR_SPEED=0.5
MAX_ANGULAR_SPEED=0.8

# Optional direct-hardware profile. Not used by the default gateway mode.
ROBOT_IMAGE=robot-control-v2:humble
BASE_IMAGE=yahboomtechnology/ros-humble:4.1.2
ROS_DOMAIN_ID=20
ROBOT_WORKSPACE_SETUP=/root/yahboomcar_ros2_ws/install/setup.bash
BASE_NODE_PACKAGE=yahboomcar_base_node
BASE_NODE_EXECUTABLE=base_node_X3
BASE_NODE_ARGS=
MICROROS_AGENT_ARGS=udp4 --port 9999 -v6
DIRECT_COMMAND_PORT=10099
COMMAND_TIMEOUT_SEC=0.7
LIDAR_REQUIRED=true
LIDAR_TIMEOUT_SEC=1.0
