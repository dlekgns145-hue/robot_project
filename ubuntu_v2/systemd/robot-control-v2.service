[Unit]
Description=Robot Control v2 Ubuntu VM middleware
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/robot-control-v2
ExecStart=/usr/bin/docker compose up -d gateway voice-command
ExecStop=/usr/bin/docker compose stop gateway voice-command
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
