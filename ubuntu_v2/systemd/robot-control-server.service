[Unit]
Description=Robot Control compute and mapping server
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/robot-control-server/ubuntu_v2
ExecStart=/opt/robot-control-server/ubuntu_v2/scripts/run_compute_mapping.sh
ExecStop=/usr/bin/docker compose --profile compute stop voice-command map-postprocessor gateway
TimeoutStartSec=0
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
